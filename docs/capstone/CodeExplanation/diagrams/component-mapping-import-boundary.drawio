          <mxGeometry x="880" y="85" width="160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="&lt;b&gt;Stop import&lt;/b&gt;&#xa;snapshot unavailable, invalid table, parse error, or target collision&#xa;&lt;b&gt;0 mutations&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="3">

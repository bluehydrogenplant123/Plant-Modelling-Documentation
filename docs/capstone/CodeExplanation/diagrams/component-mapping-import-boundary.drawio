        <mxCell id="16" value="&lt;b&gt;OUT OF SCOPE (final recap controls)&lt;/b&gt;&#xa;No System Name search/dropdown • No Domain/Port Class fields or filter on Component Mapping • No inferred extra mappings • No production C1 → CH4 row • Existing three free-text columns remain as-is" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">

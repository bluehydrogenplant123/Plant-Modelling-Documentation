        <mxCell id="5" value="&lt;b&gt;2. One mapping snapshot&lt;/b&gt;&#xa;GET /api/component-mappings&#xa;validate complete table" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="40" y="230" width="200" height="90" as="geometry" />

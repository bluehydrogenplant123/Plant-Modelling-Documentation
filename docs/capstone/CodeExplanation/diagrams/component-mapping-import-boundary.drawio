        <mxCell id="6" value="&lt;b&gt;3. Parse + metadata gate&lt;/b&gt;&#xa;row Port Class or explicitly confirmed current-domain context" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="3">
          <mxGeometry x="300" y="70" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="&lt;b&gt;5. Canonicalize whole batch&lt;/b&gt;&#xa;exact System Name wins&#xa;METHY-01 → CH3 • METHY-02 → CH4O&#xa;SULFU-01 → H2SO4" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="3">
